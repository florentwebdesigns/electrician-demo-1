# Service request form delivery (server-side only; never prefix with NEXT_PUBLIC_).
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "W Sincinnati Electrical <requests@yourdomain.com>"
LEAD_FROM_EMAIL=

# Option B: POST each request as JSON to a webhook (Zapier, Make, Slack workflow, CRM, etc.)
LEAD_WEBHOOK_URL=

# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=
